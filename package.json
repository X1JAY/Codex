{
  "name": "douyin-copy-transcript",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "extension",
    "experiments/content-resolver"
  ],
  "scripts": {
    "build": "npm --workspace extension run build",
    "typecheck": "npm --workspace extension run typecheck",
    "test": "npm --workspace extension run test",
    "resolver:typecheck": "npm --workspace douyin-content-resolver-experiment run typecheck",
